# Copy this file to `.env` (same folder) and adjust if needed.
#   copy .env.example .env        (Windows CMD)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# NOTE: Create React App only exposes variables prefixed with REACT_APP_
# to browser code, and it BAKES THEM IN AT BUILD TIME. If you change this
# value you must restart `yarn start` — a hot reload will not pick it up.

# Where the FastAPI backend is listening. lib/api.js appends "/api" itself,
# so do NOT include /api here.
REACT_APP_BACKEND_URL=http://localhost:8001
