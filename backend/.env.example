# Copy to `.env` in this folder, then fill in.
#   Copy-Item .env.example .env    (Windows PowerShell)
#   cp .env.example .env           (Mac/Linux)
#
# Never commit the real .env — it is gitignored deliberately.
#
# ONLY the first two are required. Every integration below them is optional:
# leave it blank and that feature reports itself as unavailable while the rest
# of the app runs normally. Check /api/health to see what is live.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Local Docker:  mongodb://localhost:27017
# Atlas:         mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URL=mongodb://localhost:27017

# Created automatically on first write.
DB_NAME=roster_dev


# ---------------------------------------------------------------------------
# STRONGLY RECOMMENDED
# ---------------------------------------------------------------------------

# Signs login tokens. If unset in development, a random one is generated at
# startup — which silently logs everyone out on each restart. Required in
# production, where the app refuses to boot without it.
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# "development" (default) or "production". Production forces dev routes off
# and requires JWT_SECRET.
ENV=development


# ---------------------------------------------------------------------------
# OPTIONAL — AI features (roster summary, roster-photo OCR, rule compiling)
# Get a key at https://console.anthropic.com
# Without it the roster still generates; only these three extras are inert.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929


# ---------------------------------------------------------------------------
# OPTIONAL — emailing rosters to staff. https://resend.com (free tier available)
# EMAIL_FROM must use a domain you have verified with Resend. The default
# onboarding@resend.dev works for testing but only delivers to your own address.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Roster <onboarding@resend.dev>


# Where a human should land when they click a link in an email (password
# reset). Not a security setting — see CORS_ORIGINS for that.
FRONTEND_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# OPTIONAL — Google sign-in
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
#   Application type:        Web application
#   Authorised JS origins:   http://localhost:3000
# No client secret is needed: the browser obtains an ID token and the backend
# verifies its signature. This value is public — it also ships to the frontend.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=


# ---------------------------------------------------------------------------
# OPTIONAL — billing. Test keys start with sk_test_
# BILLING_ENFORCED=false means every account has full access, which is what
# you want until you are genuinely ready to charge.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_ENFORCED=false
FREE_PLAN_ROSTER_LIMIT=4


# ---------------------------------------------------------------------------
# OPTIONAL — misc
# ---------------------------------------------------------------------------

# Browser origins allowed to call this API. A wildcard cannot be used with
# credentialed requests, so list them explicitly.
CORS_ORIGINS=http://localhost:3000

# Destructive helpers (/api/dev/reset, /api/seed-demo). Always off when
# ENV=production, regardless of this setting.
DEV_ROUTES_ENABLED=true
