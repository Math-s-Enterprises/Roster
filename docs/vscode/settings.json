{
  // Point VS Code at the project's virtual environment so IntelliSense,
  // "Go to definition" and the test runner all resolve `app.*` imports.
  // If this path is ever wrong: Ctrl+Shift+P -> "Python: Select Interpreter".
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/venv/Scripts/python.exe",

  // Backend imports are absolute (`from app.services import ...`), which only
  // resolves when `backend/` is treated as a root. Without this, VS Code
  // underlines every app import as unresolved even though the code runs fine.
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "python.analysis.autoImportCompletions": true,

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["tests"],

  "[python]": {
    "editor.rulers": [100],
    "editor.tabSize": 4
  },
  "[javascript]": { "editor.tabSize": 2 },
  "[javascriptreact]": { "editor.tabSize": 2 },

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/venv": true,
    "**/yarn.lock": true
  }
}
